# Copy to .env.local (gitignored) and fill in.
# All EXPO_PUBLIC_* values end up in the app bundle: they must be public by
# nature (URL, publishable key). Never put a secret here.

# Hosted project: Supabase dashboard → Project Settings → API Keys (publishable key).
EXPO_PUBLIC_SUPABASE_URL=https://vhrrgrocpwfspapvzwwh.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Or the local stack: `pnpm db:start` prints the API URL and the publishable key.
# On a physical device, replace 127.0.0.1 with your computer's LAN IP.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

