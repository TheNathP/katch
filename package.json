{
  "name": "katch",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter @katch/mobile start",
    "ios": "pnpm --filter @katch/mobile ios",
    "android": "pnpm --filter @katch/mobile android",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:start": "pnpm --filter @katch/backend start",
    "db:stop": "pnpm --filter @katch/backend stop",
    "db:reset": "pnpm --filter @katch/backend db:reset",
    "functions:serve": "pnpm --filter @katch/backend functions:serve"
  }
}
