{
  "name": "katch",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter @katch/mobile start",
    "ios": "pnpm --filter @katch/mobile ios",
    "android": "pnpm --filter @katch/mobile android",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrations": "pnpm --filter @katch/backend db:migrations",
    "db:push": "pnpm --filter @katch/backend db:push",
    "functions:deploy": "pnpm --filter @katch/backend functions:deploy"
  }
}
